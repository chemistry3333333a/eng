rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 로그인한 사람은 자기 기록(saves/<내 uid>)만 읽고 쓸 수 있어요
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 그 밖은 모두 막아요
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
